#!/usr/bin/env bash
# Compiler driver for a native PS5 title, the CC and CXX the game's build uses.
#
# A compile (-c, -E, -S, -M...) runs the PS5 Clang wrapper (prospero-clang18)
# unchanged. A link runs ps5-link.py, which links the intermediate PIE with
# the native app layout; build_ps5.py package converts that to eboot.bin.
#
# Adapted from Apotris-PS5 (ps5port/tooling/ps5-cc, GPL-3.0-or-later).
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

for arg in "$@"; do
    case $arg in
        -c|-E|-S|-M|-MM|--version|-v|-dumpmachine|-dumpversion|--help|-\#\#\#|-print-*)
            exec sh "$here/prospero-clang18" "$@" ;;
    esac
done
exec python3 "$here/ps5-link.py" "$@"
